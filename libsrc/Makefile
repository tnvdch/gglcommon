# ===================================================================
# Makefile for COMMON - Library
# 
# submakefile which is invoqued from top makefile
#
# created 09/06/98      MC - EF
#
# last changed : 30/10/98 
#
# =================================================================== 

VERBOSE=0
ifeq ($(VERBOSE),1)
V=
else
V=@
endif

#
# Objects to be included
#
include Objlist

#
# The Library
#
MAIN=../obj/libcommon$(EXT).a

#
# Where we will put our objects and headers
#
HDRDIR=../include
OBJDIR=../obj
OBJDIR_SED=..\/obj\/

INCLFLAGS=-I. -I$(HDRDIR)

OFILES=$(foreach file,$(OBJECTS),$(OBJDIR)/$(file).o )
CFILES=$(foreach file,$(OBJECTS),$(file).c )
HFILES=$(foreach file,$(OBJECTS),$(file).h )

RPC_FILES=$(foreach file,$(RCSOBJECTS),$(REPOSITORY)/lib/$(file).h,v\
                                    $(REPOSITORY)/lib/$(file).c,v )

#
# make binaries
#
default :
	@echo "*** Please use top makefile"

.PHONY: clean pu cleandep coro co ci

.depend : $(CFILES)
	$(V)rm -f .depend
	$(V)$(foreach cfile,$(CFILES),$(CC) $(INCLFLAGS) -MM $(cfile) |\
        sed -e '/^[a-z]/s/^/$(OBJDIR_SED)/' >> .depend && echo "" >> .depend &&) echo ""

dep : .depend

lib : libdir $(HDRDIR)/common.h $(MAIN)

libdir :
	$(V)if [ ! -d $(OBJDIR) ] ; then mkdir $(OBJDIR) ; fi

$(MAIN) : $(OFILES)
	$(V)ar -rc $(MAIN) $(OFILES)

$(OBJDIR)/%.o : %.c
	$(V)$(CC) $(CFLAGS) $(INCLFLAGS) -c $< -o $@

matcalc.c : sed_matcalc.c
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_matcalc INSTEAD!!! */" > matcalc.c
	$(V)sed -e 's/SED_T//g;s/SED_longT//g;s/SED_MATTYPE/double/g;s/SED_VERY_NEGATIVE/-9.9e306/g' sed_matcalc.c >> matcalc.c

matcalc.h : sed_matcalc.h
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_matcalc INSTEAD!!! */" > matcalc.h
	$(V)sed -e 's/SED_T//g;s/SED_longT//g;s/SED_MATTYPE/double/g;s/SED_VERY_NEGATIVE/-9.9e306/g' sed_matcalc.h >> matcalc.h

lmatcalc.c : sed_matcalc.c
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_matcalc INSTEAD!!! */" > lmatcalc.c
	$(V)sed -e 's/SED_T/l/g;s/SED_longT/long_/g;s/SED_MATTYPE/long double/g;s/SED_VERY_NEGATIVE/-9.9e306/g' sed_matcalc.c >> lmatcalc.c

lmatcalc.h : sed_matcalc.h
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_matcalc INSTEAD!!! */" > lmatcalc.h
	$(V)sed -e 's/SED_T/l/g;s/SED_longT/long_/g;s/SED_MATTYPE/long double/g;s/SED_VERY_NEGATIVE/-9.9e306/g' sed_matcalc.h >> lmatcalc.h

imatcalc.c : sed_matcalc.c
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_matcalc INSTEAD!!! */" > imatcalc.c
	$(V)sed -e 's/SED_T/i/g;s/SED_longT/int_/g;s/SED_MATTYPE/long int/g;s/SED_VERY_NEGATIVE/-2147483647/g' sed_matcalc.c >> imatcalc.c

imatcalc.h : sed_matcalc.h
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_matcalc INSTEAD!!! */" > imatcalc.h
	$(V)sed -e 's/SED_T/i/g;s/SED_longT/int_/g;s/SED_MATTYPE/long int/g;s/SED_VERY_NEGATIVE/-2147483647/g' sed_matcalc.h >> imatcalc.h

smatcalc.c : sed_matcalc.c
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_matcalc INSTEAD!!! */" > smatcalc.c
	$(V)sed -e 's/SED_T/s/g;s/SED_longT/sint_/g;s/SED_MATTYPE/short int/g;s/SED_VERY_NEGATIVE/-32767/g' sed_matcalc.c >> smatcalc.c

smatcalc.h : sed_matcalc.h
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_matcalc INSTEAD!!! */" > smatcalc.h
	$(V)sed -e 's/SED_T/s/g;s/SED_longT/sint_/g;s/SED_MATTYPE/short int/g;s/SED_VERY_NEGATIVE/-32767/g' sed_matcalc.h >> smatcalc.h

mat3.c : sed_mat3.c
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_mat3 INSTEAD!!! */" > mat3.c
	$(V)sed -e 's/SED_T//g;s/SED_bigT//g;s/SED_longT//g;s/SED_MATTYPE/double/g;s/SED_VERY_NEGATIVE/-9.9e306/g' sed_mat3.c >> mat3.c

mat3.h : sed_mat3.h
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_mat3 INSTEAD!!! */" > mat3.h
	$(V)sed -e 's/SED_T//g;s/SED_bigT//g;s/SED_longT//g;s/SED_MATTYPE/double/g;s/SED_VERY_NEGATIVE/-9.9e306/g' sed_mat3.h >> mat3.h

lmat3.c : sed_mat3.c
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_mat3 INSTEAD!!! */" > lmat3.c
	$(V)sed -e 's/SED_T/l/g;s/SED_bigT/L/g;s/SED_longT/long_/g;s/SED_MATTYPE/long double/g;s/SED_VERY_NEGATIVE/-9.9e306/g' sed_mat3.c >> lmat3.c

lmat3.h : sed_mat3.h
	$(V)echo "/*  DO NOT EDIT THIS FILE, EDIT sed_mat3 INSTEAD!!! */" > lmat3.h
	$(V)sed -e 's/SED_T/l/g;s/SED_bigT/L/g;s/SED_longT/long_/g;s/SED_MATTYPE/long double/g;s/SED_VERY_NEGATIVE/-9.9e306/g' sed_mat3.h >> lmat3.h

-include .depend

$(HDRDIR)/common.h : $(HFILES)
	$(V)if [ ! -d $(HDRDIR) ] ; then mkdir $(HDRDIR) ; fi
	$(V)rm -f $(HDRDIR)/common.h
	$(V)cat $(HFILES) >> $(HDRDIR)/common.h

install : lib
	$(V)install -m 0664 $(MAIN) $(INST_LIB_DIR)/libcommon$(EXT).$(LIBVERSION).a
	$(V)install -m 0664 $(HDRDIR)/common.h $(INST_INC_DIR)/common.$(LIBVERSION).h
	$(V)ln -s -f libcommon$(EXT).$(LIBVERSION).a $(INST_LIB_DIR)/libcommon$(EXT).a
	$(V)ln -s -f common.$(LIBVERSION).h  $(INST_INC_DIR)/common.h

cleandep:
	$(V)rm -f .depend

clean : cleandep
	$(V)rm -f $(OFILES)
	$(V)rm -f $(MAIN)

pu :
	$(V)rm -f *~ *.bak *%

